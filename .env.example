# Server
PORT=4000
JWT_SECRET=change-me-in-production

# Email alerts (optional — alerts still show in-app without these).
# Gmail: enable 2FA → create an App Password → use smtp.gmail.com:587
# Brevo free tier (300 emails/day): smtp-relay.brevo.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM="FleetIQ Alerts <alerts@yourco.co.za>"
ALERT_EMAIL_TO=

# Web portal
NEXT_PUBLIC_API_URL=http://localhost:4000
